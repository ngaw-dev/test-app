#!/bin/bash

# Database Administration Commands for DDEV Supabase
# Usage: ddev db-admin [command]

set -euo pipefail

show_help() {
    echo "🔧 Supabase Database Administration Commands"
    echo "=========================================="
    echo "Usage: ddev db-admin [command]"
    echo ""
    echo "Commands:"
    echo "  shell          - Open PostgreSQL shell"
    echo "  status        - Show database status and tables"
    echo "  create-table  - Create a new table"
    echo "  list-tables   - List all tables in database"
    echo "  query         - Run SQL query"
    echo "  backup        - Create database backup"
    echo "  restore       - Restore from backup"
    echo "  reset         - Reset database (CAUTION: destroys data)"
    echo "  help          - Show this help"
    echo ""
    echo "Database Connection Info:"
    echo "  Host: supabase-db:5432 (from DDEV)"
    echo "  External: localhost:54322 (from your machine)"
    echo "  Database: postgres"
    echo "  Username: postgres"
    echo "  Password: postgres"
}

open_shell() {
    echo "🐚 Opening PostgreSQL shell..."
    echo "Connected to database: postgres"
    echo "Use '\\q' to quit, '\\l' for list of tables"
    echo ""
    ddev exec -it supabase-db psql -U postgres -d postgres || echo "❌ Failed to open shell"
}

show_status() {
    echo "📊 Database Status"
    echo "================="
    echo "Connection: $(ddev exec supabase-db pg_isready -U postgres 2>/dev/null && echo "✅ Connected" || echo "❌ Not connected")"
    echo ""
    echo "📋 Tables:"
    ddev exec supabase-db psql -U postgres -d postgres -c "
    SELECT
        schemaname,
        tablename,
        tableowner,
        tablespace,
        hasindexes,
        hasrules,
        hastriggers
    FROM pg_tables
    WHERE schemaname NOT IN ('pg_catalog', 'information_schema')
    ORDER BY schemaname, tablename;
    " 2>/dev/null | column -t -s "|" || echo "❌ Failed to get tables"
    echo ""
    echo "📈 Database Size:"
    ddev exec supabase-db psql -U postgres -d postgres -c "SELECT pg_size_pretty(pg_database_size('postgres)) AS size;" 2>/dev/null || echo "❌ Failed to get size"
}

create_table() {
    local table_name=$1
    if [[ -z "$table_name" ]]; then
        echo "❌ Please provide a table name"
        echo "Usage: ddev db-admin create-table table_name"
        return 1
    fi

    echo "🔨 Creating table: $table_name"
    echo "Enter SQL commands (press Ctrl+D when done):"
    echo "CREATE TABLE $table_name ("
    echo "    id SERIAL PRIMARY KEY,"
    echo "    name VARCHAR(255) NOT NULL,"
    echo "    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP"
    echo ");"
    echo ""
    echo "💡 Add more columns as needed, then press Ctrl+D to execute"
}

list_tables() {
    echo "📋 Listing all tables:"
    ddev exec supabase-db psql -U postgres -d postgres -c "\dt" 2>/dev/null || echo "❌ Failed to list tables"
}

run_query() {
    echo "💻 Enter SQL query (press Ctrl+D when done):"
    local temp_file="/tmp/query_$RANDOM.sql"

    cat > "$temp_file" << 'EOF'
-- Enter your SQL query below
-- Press Ctrl+D to execute or Ctrl+C to cancel
EOF

    if command -v code >/dev/null 2>&1; then
        code "$temp_file"
    else
        echo "# Enter your SQL query below" > "$temp_file"
        echo "# Press Ctrl+D to execute or Ctrl+C to cancel" >> "$temp_file"
        read -r -d "" query_input
        echo "$query_input" >> "$temp_file"
    fi

    echo ""
    echo "🚀 Executing query..."
    ddev exec supabase-db psql -U postgres -d postgres -f "$temp_file" 2>/dev/null || echo "❌ Query failed"
    rm -f "$temp_file" 2>/dev/null
}

create_backup() {
    local backup_file="supabase-backup-$(date +%Y%m%d-%H%M%S).sql"
    echo "💾 Creating backup: $backup_file"

    ddev exec supabase-db pg_dump -U postgres -d postgres > "$backup_file" 2>/dev/null
    if [[ $? -eq 0 ]]; then
        echo "✅ Backup created: $backup_file"
        echo "File size: $(du -h "$backup_file" | cut -f1)"
    else
        echo "❌ Backup failed"
    fi
}

restore_backup() {
    local backup_file=$1
    if [[ -z "$backup_file" ]]; then
        echo "❌ Please provide a backup file path"
        echo "Usage: ddev db-admin restore /path/to/backup.sql"
        return 1
    fi

    if [[ ! -f "$backup_file" ]]; then
        echo "❌ Backup file not found: $backup_file"
        return 1
    fi

    echo "⚠️  WARNING: This will restore from backup and may overwrite existing data"
    read -p "Are you sure? (yes/no): " confirm
    if [[ "$confirm" != "yes" ]]; then
        echo "❌ Restore cancelled"
        return 1
    fi

    echo "🔄 Restoring from: $backup_file"
    ddev exec supabase-db psql -U postgres -d postgres < "$backup_file" 2>/dev/null
    if [[ $? -eq 0 ]]; then
        echo "✅ Restore completed"
    else
        echo "❌ Restore failed"
    fi
}

reset_database() {
    echo "⚠️  WARNING: This will delete ALL data in the database!"
    echo "   - All tables will be dropped"
    echo "   - All data will be lost"
    echo "   - This action cannot be undone"
    read -p "Are you absolutely sure? Type 'DELETE ALL DATA' to confirm: " confirm

    if [[ "$confirm" == "DELETE ALL DATA" ]]; then
        echo "🗑️  Dropping all tables..."
        ddev exec supabase-db psql -U postgres -d postgres -c "
        DO \$\$
            DECLARE table_name TEXT;
            DECLARE r RECORD;
            FOR r IN SELECT tablename FROM pg_tables WHERE schemaname NOT IN ('pg_catalog', 'information_schema') LOOP
                EXECUTE 'DROP TABLE IF EXISTS ' || r.tablename || ' CASCADE';
            END LOOP;
        \$\$$
        " 2>/dev/null
        echo "✅ Database reset completed"
    else
        echo "❌ Database reset cancelled"
    fi
}

# Main command routing
command=${1:-help}
case $command in
    shell)
        open_shell
        ;;
    status)
        show_status
        ;;
    create-table)
        create_table "$2"
        ;;
    list-tables)
        list_tables
        ;;
    query)
        run_query
        ;;
    backup)
        create_backup
        ;;
    restore)
        restore_backup "$2"
        ;;
    reset)
        reset_database
        ;;
    help|*)
        show_help
        ;;
esac